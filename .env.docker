APP_NAME="Haykal App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Docker project-slug prefix applied to every container / image / volume name
# by docker-compose.yaml. Override via `make rename-project NAME=your-project`.
APP_SLUG=haykal-app

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# Database (Docker PostgreSQL + PostGIS)
# ============================================================

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=haykal
DB_USERNAME=postgres
DB_PASSWORD=postgres
POSTGRES_DB=haykal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ============================================================
# Session / Cache / Queue — Redis-backed in Docker
# ============================================================

SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================
# Mail (Mailpit container)
# ============================================================

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@haykal.local"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# MinIO (S3-compatible local storage)
# ============================================================

FILESYSTEM_DISK=minio
MEDIA_DISK=minio
MINIO_ACCESS_KEY_ID=minio
MINIO_SECRET_ACCESS_KEY=minio123
MINIO_DEFAULT_REGION=us-east-1
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=haykal
MINIO_USE_PATH_STYLE_ENDPOINT=true
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

# ============================================================
# Huwiya Identity Provider
# ============================================================

# Required — fill in with your Huwiya IdP credentials before booting.
HUWIYA_URL=
HUWIYA_PROJECT_ID=
HUWIYA_CLIENT_ID=
HUWIYA_CLIENT_SECRET=
HUWIYA_REDIRECT_URI=http://localhost:8000/huwiya/callback

HUWIYA_VERIFY_SIGNATURE=true

# ============================================================
# Mapbox (optional — only needed if panels use Mapbox components)
# ============================================================

MAPBOX_TOKEN=

# ============================================================
# Vite
# ============================================================

VITE_APP_NAME="${APP_NAME}"
